# MediaHub Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here-change-this

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Database
DATABASE_PATH=storage/database.db

# API Keys (Alternatively, use config/api_keys.json)
TMDB_API_KEY=your_tmdb_api_key_here
REAL_DEBRID_API_KEY=your_real_debrid_api_key_here
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here

# Subtitle Configuration
SUBTITLE_LANGUAGES=ar,en
SUBTITLE_AUTO_DOWNLOAD=true

# Media Paths
MEDIA_ROOT=/path/to/your/media
DOWNLOADS_PATH=/path/to/downloads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security
API_KEY_REQUIRED=false
CORS_ENABLED=true

# Features
ENABLE_CASTING=true
ENABLE_HLS_STREAMING=true
ENABLE_TRANSCODING=false
