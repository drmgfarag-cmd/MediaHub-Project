{
  "name": "MediaHub Mobile",
  "short_name": "MediaHub",
  "description": "Complete media management and streaming platform",
  "start_url": "/m/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#1a1a1a",
  "background_color": "#000000",
  "scope": "/m/",
  "lang": "en",
  "categories": ["entertainment", "multimedia", "utilities"],
  "icons": [
    {
      "src": "/m/assets/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/m/assets/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/m/assets/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/m/assets/icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/m/assets/icons/icon-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/m/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/m/assets/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/m/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/m/assets/screenshots/home.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Home screen with smart content rails"
    },
    {
      "src": "/m/assets/screenshots/library.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Library browsing interface"
    },
    {
      "src": "/m/assets/screenshots/player.png",
      "sizes": "844x390",
      "type": "image/png",
      "platform": "wide",
      "label": "Video player with casting support"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Browse your media library",
      "url": "/m/#library",
      "icons": [
        {
          "src": "/m/assets/icons/library-shortcut.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Downloads",
      "short_name": "Downloads",
      "description": "Manage downloads",
      "url": "/m/#downloads",
      "icons": [
        {
          "src": "/m/assets/icons/download-shortcut.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search for content",
      "url": "/m/#search",
      "icons": [
        {
          "src": "/m/assets/icons/search-shortcut.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "capture_links": "existing-client-navigate",
  "protocol_handlers": [
    {
      "protocol": "web+mediahub",
      "url": "/m/?action=open&url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/m/?action=open",
      "accept": {
        "video/*": [".mp4", ".mkv", ".avi", ".mov", ".wmv", ".flv", ".webm"],
        "audio/*": [".mp3", ".flac", ".wav", ".aac", ".ogg", ".m4a"],
        "application/x-subrip": [".srt"],
        "text/vtt": [".vtt"]
      }
    }
  ],
  "share_target": {
    "action": "/m/?action=share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["video/*", "audio/*", ".srt", ".vtt"]
        }
      ]
    }
  }
}
