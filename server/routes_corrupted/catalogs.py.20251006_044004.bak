    return []

def _fetch_tmdb_list(list_id):
    """Fetch a TMDB list"""
    config = _load_config()
    api_key = config.get('tmdb', {}).get('api_key', '')
    
    if not api_key:
        return []
    
    try:
        url = f'https://api.themoviedb.org/3/list/{list_id}'
        params = {'api_key': api_key}
        response = requests.get(url, params=params, timeout=10)
        
        if response.status_code == 200:
            data = response.json()
            items = []
            
            for item in data.get('items', []):
                items.append({
                    'id': f"tmdb_{item.get('id')}",
                    'title': item.get('title') or item.get('name'),
                    'overview': item.get('overview'),
                    'poster_url': f"https://image.tmdb.org/t/p/w500{item.get('poster_path')}" if item.get('poster_path') else None,
                    'backdrop_url': f"https://image.tmdb.org/t/p/w1280{item.get('backdrop_path')}" if item.get('backdrop_path') else None,
                    'rating': item.get('vote_average'),
                    'release_date': item.get('release_date') or item.get('first_air_date'),
                    'media_type': item.get('media_type', 'movie'),
                    'source': 'tmdb'
                })
            
            return items
    except Exception:
        pass
    
    return []

def _fetch_kitsu_trending():
    """Fetch trending anime from Kitsu"""
    try:
        url = 'https://kitsu.io/api/edge/trending/anime'
        response = requests.get(url, timeout=10)
        
        if response.status_code == 200:
            data = response.json()
            items = []
            
            for item in data.get('data', []):
                attrs = item.get('attributes', {})
                items.append({
                    'id': f"kitsu_{item.get('id')}",
                    'title': attrs.get('canonicalTitle') or attrs.get('titles', {}).get('en'),
                    'overview': attrs.get('synopsis'),
                    'poster_url': attrs.get('posterImage', {}).get('large'),
                    'backdrop_url': attrs.get('coverImage', {}).get('large'),
                    'rating': attrs.get('averageRating'),
                    'release_date': attrs.get('startDate'),
                    'media_type': 'anime',
                    'source': 'kitsu'
                })
            
            return items
    except Exception:
        pass
    
    return []

def _fetch_kitsu_top_rated():
    """Fetch top rated anime from Kitsu"""
    try:
        url = 'https://kitsu.io/api/edge/anime'
        params = {'sort': '-averageRating', 'page[limit]': 20}
        response = requests.get(url, params=params, timeout=10)
        
        if response.status_code == 200:
            data = response.json()
            items = []
            
            for item in data.get('data', []):
                attrs = item.get('attributes', {})
                items.append({
                    'id': f"kitsu_{item.get('id')}",
                    'title': attrs.get('canonicalTitle') or attrs.get('titles', {}).get('en'),
                    'overview': attrs.get('synopsis'),
                    'poster_url': attrs.get('posterImage', {}).get('large'),
                    'backdrop_url': attrs.get('coverImage', {}).get('large'),
                    'rating': attrs.get('averageRating'),
                    'release_date': attrs.get('startDate'),
                    'media_type': 'anime',
                    'source': 'kitsu'
                })
            
            return items
    except Exception:
        pass
    
    return []

@catalogs_bp.route('/api/catalogs/config', methods=['GET'])
def get_config():
    try:
        """Get catalogs configuration"""
        config = _load_config()
        return jsonify({
        'ok': True,
        'config': config
        })

        # DUPLICATE REMOVED: @catalogs_bp.route('/api/catalogs/config', methods=['POST'])
        # DUPLICATE REMOVED: def set_config():
        """
        Update catalogs configuration
        Body: {
        "tmdb": {
        "enabled": true,
        "api_key": "your_api_key"
        }
        }
        """
        req_data = request.get_json(silent=True) or {}

        config = _load_config()
        config.update(req_data)
        _save_config(config)

        return jsonify({
        'ok': True,
        'message': 'Configuration updated',
        'config': config
        })

        @catalogs_bp.route('/api/catalogs/tmdb/trending/<media_type>', methods=['GET'])
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

def tmdb_trending(media_type):
    try:
        """
        Get trending items from TMDB
        media_type: movie, tv
        Query params: time_window (day, week)
        """
        time_window = request.args.get('time_window', 'week')
        cache_key = f'tmdb_trending_{media_type}_{time_window}'

        # Check cache
        cached = _get_cached_data(cache_key)
        if cached is not None:
        return jsonify({
        'ok': True,
        'items': cached,
        'cached': True
        })

        # Fetch fresh data
        items = _fetch_tmdb_trending(media_type, time_window)
        _save_cached_data(cache_key, items)

        return jsonify({
        'ok': True,
        'items': items,
        'cached': False
        })

