from flask import Blueprint, jsonify, request
import os, json, re
from datetime import datetime
import requests

catalogs_bp = Blueprint('catalogs', __name__)

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
STO = os.path.join(ROOT, 'storage')
CATALOGS_CONFIG = os.path.join(STO, 'config', 'catalogs.json')
CATALOGS_CACHE = os.path.join(STO, 'catalogs_cache')

def _load_config():
    """Load catalogs configuration"""
    try:
        with open(CATALOGS_CONFIG, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return {
            'tmdb': {
                'enabled': True,
                'api_key': '',
                'language': 'en-US'
            },
            'imdb': {
                'enabled': True
            },
            'kitsu': {
                'enabled': True
            },
            'cache_duration_hours': 6
        }

def _save_config(data):
    """Save catalogs configuration"""
    os.makedirs(os.path.dirname(CATALOGS_CONFIG), exist_ok=True)
    tmp = CATALOGS_CONFIG + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, CATALOGS_CONFIG)

def _get_cached_data(cache_key):
    """Get cached catalog data"""
    cache_file = os.path.join(CATALOGS_CACHE, f'{cache_key}.json')
    try:
        if os.path.exists(cache_file):
            with open(cache_file, 'r', encoding='utf-8') as f:
                data = json.load(f)
                # Check if cache is still valid
                cached_at = datetime.fromisoformat(data.get('cached_at', '').replace('Z', '+00:00'))
                config = _load_config()
                cache_duration_hours = config.get('cache_duration_hours', 6)
                age_hours = (datetime.utcnow() - cached_at.replace(tzinfo=None)).total_seconds() / 3600
                
                if age_hours < cache_duration_hours:
                    return data.get('items', [])
    except Exception:
        pass
    return None

def _save_cached_data(cache_key, items):
    """Save catalog data to cache"""
    os.makedirs(CATALOGS_CACHE, exist_ok=True)
    cache_file = os.path.join(CATALOGS_CACHE, f'{cache_key}.json')
    data = {
        'cached_at': datetime.utcnow().isoformat() + 'Z',
        'items': items
    }
    tmp = cache_file + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, cache_file)

def _fetch_tmdb_trending(media_type='movie', time_window='week'):
    """Fetch trending items from TMDB"""
    config = _load_config()
    api_key = config.get('tmdb', {}).get('api_key', '')
    
    if not api_key:
        return []
    
    try:
        url = f'https://api.themoviedb.org/3/trending/{media_type}/{time_window}'
        params = {'api_key': api_key}
        response = requests.get(url, params=params, timeout=10)
        
        if response.status_code == 200:
            data = response.json()
            items = []
            
            for item in data.get('results', []):
                items.append({
                    'id': f"tmdb_{item.get('id')}",
                    'title': item.get('title') or item.get('name'),
                    'overview': item.get('overview'),
                    'poster_url': f"https://image.tmdb.org/t/p/w500{item.get('poster_path')}" if item.get('poster_path') else None,
                    'backdrop_url': f"https://image.tmdb.org/t/p/w1280{item.get('backdrop_path')}" if item.get('backdrop_path') else None,
                    'rating': item.get('vote_average'),
                    'release_date': item.get('release_date') or item.get('first_air_date'),
                    'media_type': media_type,
                    'source': 'tmdb'
                })
            
            return items
    except Exception:
        pass
    
    return []

