        @catalogs_bp.route('/api/catalogs/cache/clear', methods=['POST'])
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

def clear_cache():
    """Clear catalog cache"""
    try:
        if os.path.exists(CATALOGS_CACHE):
            for filename in os.listdir(CATALOGS_CACHE):
                file_path = os.path.join(CATALOGS_CACHE, filename)
                if os.path.isfile(file_path):
                    os.remove(file_path)
        
        return jsonify({
            'ok': True,
            'message': 'Cache cleared'
        })
    except Exception as e:
        return jsonify({
            'ok': False,
            'error': str(e)
        }), 500

@catalogs_bp.route('/api/catalogs/all', methods=['GET'])
def get_all_catalogs():
    try:
        """Get all available catalogs"""
        config = _load_config()

        catalogs = []

        # TMDB catalogs
        if config.get('tmdb', {}).get('enabled'):
        catalogs.extend([
        {'id': 'tmdb_trending_movie', 'name': 'Trending Movies', 'source': 'tmdb', 'type': 'trending'},
        {'id': 'tmdb_trending_tv', 'name': 'Trending TV Shows', 'source': 'tmdb', 'type': 'trending'},
        {'id': 'tmdb_top_rated_movie', 'name': 'Top Rated Movies', 'source': 'tmdb', 'type': 'top_rated'},
        {'id': 'tmdb_top_rated_tv', 'name': 'Top Rated TV Shows', 'source': 'tmdb', 'type': 'top_rated'}
        ])

        # Kitsu catalogs
        if config.get('kitsu', {}).get('enabled'):
        catalogs.extend([
        {'id': 'kitsu_trending', 'name': 'Trending Anime', 'source': 'kitsu', 'type': 'trending'},
        {'id': 'kitsu_top_rated', 'name': 'Top Rated Anime', 'source': 'kitsu', 'type': 'top_rated'}
        ])

        return jsonify({
        'ok': True,
        'catalogs': catalogs,
        'total': len(catalogs)
        })
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500
