@rss_automation_bp.route('/api/rss/series-monitoring')
def get_series_monitoring():
    """Get all monitored series"""
    try:
        conn = sqlite3.connect(RSS_DB)
        cursor = conn.cursor()
        
        cursor.execute('''
            SELECT sm.*, qp.name as quality_profile_name,
                   COUNT(ri.id) as available_episodes,
                   COUNT(CASE WHEN ri.status = 'downloaded' THEN 1 END) as downloaded_episodes
            FROM series_monitoring sm
            LEFT JOIN quality_profiles qp ON sm.quality_profile_id = qp.id
            LEFT JOIN rss_items ri ON sm.series_name = ri.series_name
            GROUP BY sm.id
            ORDER BY sm.series_name
        ''')
        
        columns = [description[0] for description in cursor.description]
        results = [dict(zip(columns, row)) for row in cursor.fetchall()]
        
        # Process JSON fields
        for result in results:
            for field in ['subtitle_languages', 'metadata_json']:
                if result.get(field):
                    try:
                        result[field] = json.loads(result[field])
                    except:
                        result[field] = None
        
        conn.close()
        return jsonify(results)
        
    except Exception as e:
        return jsonify({'error': str(e)}), 500

