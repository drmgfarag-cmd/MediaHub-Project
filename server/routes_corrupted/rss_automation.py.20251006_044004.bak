"""
Phase 4: RSS Automation & Quality Management
Implements advanced RSS feed automation, quality profiles, and automatic content acquisition
"""

from flask import Blueprint, request, jsonify
import os
import json
import sqlite3
import requests
import feedparser
import re
from datetime import datetime, timedelta
import threading
import time
import hashlib
from urllib.parse import urlparse, parse_qs

rss_automation_bp = Blueprint('rss_automation', __name__)

# Configuration
ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
STORAGE = os.path.join(ROOT, 'storage')
RSS_DB = os.path.join(STORAGE, 'rss_automation.db')
QUALITY_PROFILES = os.path.join(STORAGE, 'quality_profiles.json')

def init_rss_automation_db():
    """Initialize RSS automation database"""
    conn = sqlite3.connect(RSS_DB)
    cursor = conn.cursor()
    
    # RSS feeds table
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS rss_feeds (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT UNIQUE NOT NULL,
            url TEXT NOT NULL,
            feed_type TEXT, -- tv, movies, books, comics, music
            quality_profile_id INTEGER,
            enabled BOOLEAN DEFAULT TRUE,
            auto_download BOOLEAN DEFAULT FALSE,
            last_checked TIMESTAMP,
            last_updated TIMESTAMP,
            check_interval INTEGER DEFAULT 3600, -- seconds
            max_age_days INTEGER DEFAULT 30,
            include_patterns TEXT, -- JSON array of regex patterns
            exclude_patterns TEXT, -- JSON array of regex patterns
            custom_headers TEXT, -- JSON object
            authentication TEXT, -- JSON object
            metadata_json TEXT,
            created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    # RSS feed items/episodes
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS rss_items (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            feed_id INTEGER NOT NULL,
            guid TEXT NOT NULL,
            title TEXT NOT NULL,
            description TEXT,
            link TEXT,
            magnet_link TEXT,
            torrent_url TEXT,
            pub_date TIMESTAMP,
            size_bytes INTEGER,
            seeders INTEGER,
            leechers INTEGER,
            quality_score INTEGER,
            scene_group TEXT,
            resolution TEXT,
            codec TEXT,
            source TEXT,
            season_number INTEGER,
            episode_number INTEGER,
            episode_title TEXT,
            series_name TEXT,
            imdb_id TEXT,
            tvdb_id INTEGER,
            status TEXT DEFAULT 'new', -- new, downloading, downloaded, failed, ignored
            download_started TIMESTAMP,
            download_completed TIMESTAMP,
            file_path TEXT,
            rd_id TEXT,
            metadata_json TEXT,
            created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (feed_id) REFERENCES rss_feeds(id),
            UNIQUE(feed_id, guid)
        )
    ''')
    
    # Quality profiles
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS quality_profiles (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT UNIQUE NOT NULL,
            description TEXT,
            config_json TEXT NOT NULL,
            is_default BOOLEAN DEFAULT FALSE,
            created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            updated_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    # Scene groups with scoring
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS scene_groups (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT UNIQUE NOT NULL,
            tier INTEGER DEFAULT 2, -- 1=premium, 2=standard, 3=low, 0=blocked
            base_score INTEGER DEFAULT 50,
            specialties TEXT, -- JSON array
            quality_bonus INTEGER DEFAULT 0,
            reliability_score INTEGER DEFAULT 50,
            notes TEXT,
            last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    # Download queue
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS download_queue (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            rss_item_id INTEGER NOT NULL,
            priority INTEGER DEFAULT 5,
            status TEXT DEFAULT 'queued', -- queued, downloading, completed, failed, paused
            progress REAL DEFAULT 0.0,
            download_speed INTEGER DEFAULT 0,
            eta_seconds INTEGER,
            error_message TEXT,
            retry_count INTEGER DEFAULT 0,
            max_retries INTEGER DEFAULT 3,
            added_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            started_date TIMESTAMP,
            completed_date TIMESTAMP,
            FOREIGN KEY (rss_item_id) REFERENCES rss_items(id)
        )
    ''')
    
    # Automation rules
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS automation_rules (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT UNIQUE NOT NULL,
            description TEXT,
            rule_type TEXT NOT NULL, -- series_monitor, movie_watchlist, book_series
            conditions_json TEXT NOT NULL,
            actions_json TEXT NOT NULL,
            enabled BOOLEAN DEFAULT TRUE,
            priority INTEGER DEFAULT 5,
            last_triggered TIMESTAMP,
            trigger_count INTEGER DEFAULT 0,
            created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    # Series monitoring
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS series_monitoring (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            series_name TEXT NOT NULL,
            imdb_id TEXT,
            tvdb_id INTEGER,
            quality_profile_id INTEGER,
            monitor_status TEXT DEFAULT 'active', -- active, paused, completed, cancelled
            current_season INTEGER,
            current_episode INTEGER,
            auto_search BOOLEAN DEFAULT TRUE,
            search_cutoff_date DATE,
            preferred_language TEXT DEFAULT 'en',
            subtitle_languages TEXT, -- JSON array
            metadata_json TEXT,
            created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (quality_profile_id) REFERENCES quality_profiles(id)
        )
    ''')
    
    # Create indexes
    cursor.execute('CREATE INDEX IF NOT EXISTS idx_rss_items_status ON rss_items(status)')
    cursor.execute('CREATE INDEX IF NOT EXISTS idx_rss_items_pub_date ON rss_items(pub_date)')
    cursor.execute('CREATE INDEX IF NOT EXISTS idx_rss_items_series ON rss_items(series_name, season_number, episode_number)')
    cursor.execute('CREATE INDEX IF NOT EXISTS idx_download_queue_status ON download_queue(status)')
    cursor.execute('CREATE INDEX IF NOT EXISTS idx_series_monitoring_status ON series_monitoring(monitor_status)')
    
    conn.commit()
    conn.close()

# Initialize database on import
init_rss_automation_db()

@rss_automation_bp.route('/api/rss/feeds')
def get_rss_feeds():
    """Get all RSS feeds with status"""
    try:
        conn = sqlite3.connect(RSS_DB)
        cursor = conn.cursor()
        
        cursor.execute('''
            SELECT f.*, qp.name as quality_profile_name,
                   COUNT(ri.id) as total_items,
                   COUNT(CASE WHEN ri.status = 'downloaded' THEN 1 END) as downloaded_items,
                   COUNT(CASE WHEN ri.status = 'downloading' THEN 1 END) as downloading_items
            FROM rss_feeds f
            LEFT JOIN quality_profiles qp ON f.quality_profile_id = qp.id
            LEFT JOIN rss_items ri ON f.id = ri.feed_id
            GROUP BY f.id
            ORDER BY f.name
        ''')
        
        columns = [description[0] for description in cursor.description]
        results = [dict(zip(columns, row)) for row in cursor.fetchall()]
        
        # Process JSON fields
        for result in results:
            for field in ['include_patterns', 'exclude_patterns', 'custom_headers', 'authentication', 'metadata_json']:
                if result.get(field):
                    try:
                        result[field] = json.loads(result[field])
                    except:
                        result[field] = None
        
        conn.close()
        return jsonify(results)
        
    except Exception as e:
        return jsonify({'error': str(e)}), 500

