    """Manually check RSS feed for new items"""
    try:
        result = check_rss_feed(feed_id)
        return jsonify(result)
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@rss_automation_bp.route('/api/rss/items')
def get_rss_items():
    """Get RSS items with filtering"""
    try:
        feed_id = request.args.get('feed_id', type=int)
        status = request.args.get('status')
        series_name = request.args.get('series')
        season = request.args.get('season', type=int)
        page = int(request.args.get('page', 1))
        limit = int(request.args.get('limit', 50))
        
        conn = sqlite3.connect(RSS_DB)
        cursor = conn.cursor()
        
        query = '''
            SELECT ri.*, f.name as feed_name, qp.name as quality_profile_name
            FROM rss_items ri
            JOIN rss_feeds f ON ri.feed_id = f.id
            LEFT JOIN quality_profiles qp ON f.quality_profile_id = qp.id
            WHERE 1=1
        '''
        params = []
        
        if feed_id:
            query += ' AND ri.feed_id = ?'
            params.append(feed_id)
        
        if status:
            query += ' AND ri.status = ?'
            params.append(status)
        
        if series_name:
            query += ' AND ri.series_name LIKE ?'
            params.append(f'%{series_name}%')
        
        if season:
            query += ' AND ri.season_number = ?'
            params.append(season)
        
        # Get total count
        count_query = query.replace('SELECT ri.*, f.name as feed_name, qp.name as quality_profile_name', 'SELECT COUNT(*)')
        cursor.execute(count_query, params)
        total = cursor.fetchone()[0]
        
        # Add sorting and pagination
        query += ' ORDER BY ri.pub_date DESC LIMIT ? OFFSET ?'
        offset = (page - 1) * limit
        params.extend([limit, offset])
        
        cursor.execute(query, params)
        columns = [description[0] for description in cursor.description]
        results = [dict(zip(columns, row)) for row in cursor.fetchall()]
        
        # Process JSON fields
        for result in results:
            if result.get('metadata_json'):
                try:
                    result['metadata'] = json.loads(result['metadata_json'])
                except:
                    result['metadata'] = {}
        
        conn.close()
        
        return jsonify({
            'items': results,
            'total': total,
            'page': page,
            'limit': limit,
            'pages': (total + limit - 1) // limit
        })
        
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@rss_automation_bp.route('/api/rss/quality-profiles')
def get_quality_profiles():
    """Get all quality profiles"""
    try:
        conn = sqlite3.connect(RSS_DB)
        cursor = conn.cursor()
        
        cursor.execute('''
            SELECT qp.*, COUNT(f.id) as feed_count
            FROM quality_profiles qp
            LEFT JOIN rss_feeds f ON qp.id = f.quality_profile_id
            GROUP BY qp.id
            ORDER BY qp.is_default DESC, qp.name
        ''')
        
        columns = [description[0] for description in cursor.description]
        results = [dict(zip(columns, row)) for row in cursor.fetchall()]
        
        # Process config JSON
        for result in results:
            if result.get('config_json'):
                try:
                    result['config'] = json.loads(result['config_json'])
                except:
                    result['config'] = {}
        
        conn.close()
        return jsonify(results)
        
    except Exception as e:
        return jsonify({'error': str(e)}), 500

