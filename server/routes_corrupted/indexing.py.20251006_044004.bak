from flask import Blueprint, jsonify, request
import os, json, time, sqlite3, re

idx_bp = Blueprint('idx', __name__)
ROOT=os.path.abspath(os.path.join(os.path.dirname(__file__),'..','..'))
STO=os.path.join(ROOT,'storage')
LIBJSON=os.path.join(STO,'library_index.json')
DB=os.path.join(STO,'library.sqlite')
FF=os.path.join(STO,'ffprobe_cache.json')
PC=os.path.join(STO,'posters_cache.json')

def _items():
    try: return json.load(open(LIBJSON,'r',encoding='utf-8'))
    except Exception: return []

def _mkdb():
    if os.path.exists(DB): os.remove(DB)
    con=sqlite3.connect(DB); cur=con.cursor()
    cur.execute("CREATE TABLE items(id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, title TEXT, path TEXT, year INT, rating TEXT, genres TEXT, added_ts INT)")
    cur.execute("CREATE INDEX idx_title ON items(title)"); cur.execute("CREATE INDEX idx_path ON items(path)"); cur.execute("CREATE INDEX idx_type ON items(type)")
    its=_items(); n=0
    for it in its:
        title=it.get('title') or os.path.basename(it.get('path') or '')
        path=it.get('path') or ''
        year=int(it.get('year') or 0)
        rating=it.get('rating') or it.get('mpaa') or it.get('tv_rating') or ''
        genres=','.join([g for g in (it.get('genres') or []) if g])
        added=int(it.get('added_ts') or 0)
        cur.execute("INSERT INTO items(type,title,path,year,rating,genres,added_ts) VALUES(?,?,?,?,?,?,?)", (it.get('type',''), title, path, year, rating, genres, added))
        n+=1
    con.commit(); con.close()
    return n

@idx_bp.route('/api/index/sqlite_build', methods=['POST'])
def sqlite_build():
    try:
        t0=time.time()
        n=_mkdb()
        return jsonify({'ok':True,'rows':n,'took_ms': int((time.time()-t0)*1000)})

        @idx_bp.route('/api/index/sqlite_status')
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

def sqlite_status():
    ok=os.path.exists(DB); size=os.path.getsize(DB) if ok else 0
    con=None; cnt=0
    try:
        con=sqlite3.connect(DB); cur=con.cursor(); cur.execute("SELECT COUNT(*) FROM items"); cnt=cur.fetchone()[0]
    except Exception:
        pass
    finally:
        con and con.close()
    return jsonify({'exists': ok, 'size_bytes': size, 'rows': cnt})

@idx_bp.route('/api/search/spotlight')
def spotlight():
    try:
        q=(request.args.get('q') or '').strip()
        if not os.path.exists(DB): return jsonify({'error':'no index'}), 400
        con=sqlite3.connect(DB); cur=con.cursor()
        t0=time.time()
        if q:
        # LIKE-based quick search (case-insensitive using lower())
        p=f"%{q.lower()}%"
        cur.execute("SELECT type,title,path,year FROM items WHERE lower(title) LIKE ? OR lower(path) LIKE ? ORDER BY added_ts DESC LIMIT 100", (p,p))
        else:
        cur.execute("SELECT type,title,path,year FROM items ORDER BY added_ts DESC LIMIT 100")
        rows=cur.fetchall(); con.close()
        took=int((time.time()-t0)*1000)
        items=[{'type':r[0],'title':r[1],'path':r[2],'year':r[3]} for r in rows]
        return jsonify({'items': items, 'took_ms': took})

        @idx_bp.route('/api/index/query')
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

def ro_query():
    sql=(request.args.get('sql') or '').strip()
    if not sql.lower().startswith('select'):
        return jsonify({'error':'read-only SELECT queries only'}), 400
    if not os.path.exists(DB): return jsonify({'error':'no index'}), 400
    con=sqlite3.connect(DB); cur=con.cursor()
    try:
        cur.execute(sql); cols=[d[0] for d in cur.description]; rows=cur.fetchall()
        data=[{cols[i]:v[i] for i in range(len(cols))} for v in rows]
        return jsonify({'rows': data, 'count': len(data)})
    except Exception as e:
        return jsonify({'error': str(e)}), 400
    finally:
        con.close()

@idx_bp.route('/api/ffprobe/batch', methods=['POST'])
def ffprobe_batch():
    # offline-safe heuristic: infer channels/sample rate from file tokens
    try: dat=json.load(open(FF,'r',encoding='utf-8'))
    except Exception: dat={'items':{},'scanned_ts':0}
    its=_items(); n=0
    for it in its:
        p=(it.get('path') or ''); 
        if not p or p in dat['items']: continue
        low=p.lower()
        sr = 192000 if '192k' in low else (96000 if '96k' in low else 44100)
        ch = 8 if 'atmos' in low or '7.1' in low else (6 if '5.1' in low else 2)
        dat['items'][p]={'sample_rate': sr, 'channels': ch, 'ts': int(time.time())}; n+=1
    dat['scanned_ts']=int(time.time())
    tmp=FF+'.tmp'; json.dump(dat, open(tmp,'w',encoding='utf-8'), indent=2); os.replace(tmp, FF)
    return jsonify({'ok':True,'new': n, 'total': len(dat['items'])})

@idx_bp.route('/api/posters/cache_build', methods=['POST'])
def posters_build():
    try: dat=json.load(open(PC,'r',encoding='utf-8'))
    except Exception: dat={'items':{},'built_ts':0}
    its=_items(); n=0
    for it in its:
        t=it.get('title') or os.path.basename(it.get('path') or '')
        key=(it.get('path') or t)
        if key not in dat['items']:
            # placeholder manifest entry: in a real build, resolve poster image path
            dat['items'][key]={'poster':'', 'thumb':'', 'title':t}
            n+=1
    dat['built_ts']=int(time.time())
    tmp=PC+'.tmp'; json.dump(dat, open(tmp,'w',encoding='utf-8'), indent=2); os.replace(tmp, PC)
    return jsonify({'ok':True,'new': n, 'total': len(dat['items'])})
